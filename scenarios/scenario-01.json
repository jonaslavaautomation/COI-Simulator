{
  "id": "scenario-01",
  "title": "Scenario 1 - General Liability for Landlord",
  "formType": "acord-25",
  "summary": "Suncrest Painting LLC emails asking for a certificate for their landlord. Not every request in the email is something their policy actually supports — check the agency file before you complete the form.",
  "instructions": [
    "Read the email from Suncrest Painting and weigh every request against the agency file below — only enter coverage and endorsements that actually exist on file.",
    "Complete the producer, named insured, insurer, certificate number, and General Liability section using the policy file exactly as written.",
    "Use the exact remark wording the property manager requires in the description of operations box.",
    "If a requested coverage isn't listed in the agency file, leave that section of the form blank — never assume coverage that isn't documented.",
    "A perfect score is required to unlock the next scenario."
  ],
  "request": [
    {
      "label": "Date",
      "lines": [
        "04/29/2026"
      ]
    },
    {
      "label": "Client Email",
      "lines": [
        "From: Marcus Webb, Owner, Suncrest Painting LLC <mwebb@suncrestpainting.com>",
        "To: certificates@lavatraining.com",
        "Subject: COI needed for Bayfront Commercial Properties",
        "Hi Ana,",
        "We just signed on to repaint the exterior of a strip mall for Bayfront Commercial Properties, LLC. Their property manager needs a certificate before we can get on site Monday.",
        "They need to be listed as additional insured and they want a waiver of subrogation too. Here's the exact wording their property manager, Denise, wants in the description box:",
        "\"Certificate holder is included as additional insured and waiver of subrogation applies with respect to the painting work at 88 Bayfront Plaza, Tampa, FL.\"",
        "Denise also mentioned our crew will be up on ladders and scaffolding, and asked if we could show workers comp coverage on the certificate too, just to be safe. Can you take care of this today?",
        "Thanks,",
        "Marcus"
      ]
    },
    {
      "label": "Certificate Holder / Requestor",
      "lines": [
        "Bayfront Commercial Properties, LLC",
        "Attn: Property Management",
        "88 Bayfront Plaza",
        "Tampa, FL 33607"
      ]
    },
    {
      "label": "Certificate",
      "lines": [
        "Certificate No: CERT-1001",
        "Revision No: leave blank"
      ]
    }
  ],
  "policyEvidence": [
